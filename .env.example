# Backend del MVP. Solo servidor; incluye el prefijo versionado del API.
API_URL=http://localhost:8080/api/v1

# Activa MSW únicamente para desarrollo frontend aislado.
NEXT_PUBLIC_ENABLE_MOCKS=false

# Autenticación del MVP.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# Creación de eventos: Cloudinary se firma únicamente desde el servidor.
CLOUDINARY_CLOUD_NAME=meevent
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Preset firmado obligatorio con formatos jpg,jpeg,png,webp y límite servidor de 5 MB.
CLOUDINARY_UPLOAD_PRESET=

# Creación de eventos: clave web restringida por dominio y Map ID de JavaScript.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Analítica exclusiva de la landing institucional.
NEXT_PUBLIC_CLARITY_ID=

# Captura temporal de leads de la landing (solo servidor).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
